# Vorlage für AGENT/.env  —  kopieren mit:  cp AGENT/.env.example AGENT/.env
#
# Diese Datei wird NIE geladen. Zur Laufzeit liest Jude ausschließlich
# AGENT/.env (main.py und alle Skripte in scripts/). Hier stehen deshalb
# niemals echte Schlüssel, nur Namen und unkritische Vorgaben.
#
# Leer gelassene Werte sind in Ordnung: Dienste ohne Schlüssel melden sich als
# "nicht eingerichtet" und werden übersprungen, statt den Start zu verhindern.

# --- Cloud-Modelle (alle optional; ohne Schlüssel bleibt Jude rein lokal) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Groq: kostenfreie Stufe, 100.000 Token pro Tag. Verbrauch und Restbestand
# zeigt die Kopfleiste der GUI; unterhalb der Reserve wird Groq übersprungen.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
JUDE_PAID_MODELS_ENABLED=true
JUDE_CLOUD_BUDGET_USD=5.00
JUDE_CLOUD_REQUEST_LIMIT_USD=1.00
# Kein Anthropic Fast-/Priority-Tarif: Standard wird explizit erzwungen.
ANTHROPIC_SERVICE_TIER=standard_only
OPENAI_SERVICE_TIER=default
NEWS_API_KEY=
FACT_CHECK_MAX_CLAIMS=5
# Lokale Modelle über Ollama
OLLAMA_URL=http://127.0.0.1:11434
# JUDE_EMBED_MODEL=nomic-embed-text   # für Dokumentwissen (ollama pull nötig)

# --- Web-GUI und Dienst ---
# Pflicht, sobald die GUI von außerhalb dieses Rechners erreichbar sein soll.
# Bleiben beide leer, sind nur Zugriffe von 127.0.0.1 erlaubt.
JUDE_GUI_USER=
JUDE_GUI_PASSWORD=
JUDE_HOST=127.0.0.1
JUDE_PORT=8765
# JUDE_ALLOWED_HOSTS=meinpc.local   # zusätzliche erlaubte Host-Header (CSRF-Schutz)

# --- Ablageorte (nur setzen, wenn vom Standard abgewichen wird) ---
# AI_DATA_ROOT=/media/d4sd1ng/AI-Data      # Wurzel über allen Projekten
# JUDE_DATA_DIR=/media/d4sd1ng/AI-Data/Jude/data   # DB, Logs, Mitarbeiterdaten
# JUDE_GENERATED_TOOLS_DIR=                 # selbst geschriebene Werkzeuge

# --- Notion ---
# Der Schlüssel ist eine Integration; jede Datenbank muss ihr in Notion
# ausdrücklich freigegeben werden, sonst liefert die API 404.
NOTION_API_KEY=
NOTION_DB_CONTACTS=
NOTION_DB_SEQUENCES=
NOTION_DB_CONTENT=
NOTION_DB_CONTENT_PIECES=
NOTION_DB_SCHEDULING=
NOTION_DB_SOCIAL=
NOTION_DB_SUBSCRIBERS=
NOTION_DB_RECIPES=
NOTION_DB_MEALPLAN=

# --- Mailkonten: PASSWORD ist ein App-Passwort, nicht das Kontopasswort ---
MAIL_GMX_USERNAME=
MAIL_GMX_PASSWORD=
MAIL_YAHOO_USERNAME=
MAIL_YAHOO_PASSWORD=
MAIL_GMAIL_USERNAME=
MAIL_GMAIL_PASSWORD=
# Proton benötigt die lokale Bridge; die Ports sind deren Vorgaben.
MAIL_PROTON_NUROVELLE_USERNAME=
MAIL_PROTON_NUROVELLE_PASSWORD=
MAIL_PROTON_NUROVELLE_IMAP_PORT=1143
MAIL_PROTON_NUROVELLE_SMTP_PORT=1025
MAIL_PROTON_NUROVELLE_VERIFY_TLS=false
MAIL_PROTON_MONGOJUDE_USERNAME=
MAIL_PROTON_MONGOJUDE_PASSWORD=
MAIL_PROTON_MONGOJUDE_IMAP_PORT=1143
MAIL_PROTON_MONGOJUDE_SMTP_PORT=1025
MAIL_PROTON_MONGOJUDE_VERIFY_TLS=false

# --- Spracherkennung und Aktivierungswort ---
# Modelle werden unter AI-Data/Jude/models automatisch gefunden. Nur setzen,
# wenn sie woanders liegen — ein falscher Pfad verhindert das Laden.
# WHISPER_MODEL=
# WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=de
# Verfahren fürs Aktivierungswort: 'whisper' vergleicht laufend transkribierte
# Audiofenster (frei wählbarer Wortlaut, aber dauerhafte Rechenlast),
# 'onnx' nutzt das trainierte Modell (schlank, aber auf sein Wort festgelegt).
# JUDE_WAKE_ENGINE=whisper
# JUDE_WAKE_PHRASE=Jude angetreten
# JUDE_SLEEP_PHRASE=Jude Zapfenstreich
# JUDE_GREETING=Zu Befehl.
# JUDE_FAREWELL=Zapfenstreich.
# JUDE_WAKE_WINDOW=2.0        # Länge des geprüften Audiofensters in Sekunden
# JUDE_WAKE_HOP=0.5           # Abstand zwischen zwei Prüfungen
# VOICE_ENERGY_THRESHOLD=     # Rauschschwelle; leer = automatisch
# WAKE_WORD_MODEL=            # nur für JUDE_WAKE_ENGINE=onnx
WAKE_WORD_THRESHOLD=0.42
# WAKE_WORD_TRIGGER_FRAMES=2

# --- Sprachausgabe ---
# PIPER_MODEL=                 # leer = Stimme aus AI-Data/Jude/models/piper
# PIPER_SPEAKER=               # nur bei mehrstimmigen Modellen
# JUDE_USER_NAME=Tino          # wie Jude den Nutzer anspricht
# JUDE_TTS_PITCH=1.08          # >1 heller/weniger tief, 1.0 = neutral
# JUDE_TTS_SPEED=1.0
# JUDE_BRIEFING=true           # Kurzbriefing beim Aufwachen vorlesen
# JUDE_BRIEFING_ICT_LIVE=false # true = frische ICT-Analyse je Aufwachen (langsam)

# --- Gedächtnis und Profil ---
# JUDE_PROFILE=Ich handle Gold und BTC nach ICT; Ich bevorzuge kurze Antworten
# JUDE_MEMORY_AUTOAPPROVE=0.8  # ab dieser Konfidenz automatisch bestätigt

# --- Bilder und 3D ---
# JUDE_IMAGE_MODEL=gpt-image-1
# BLENDER_BIN=/usr/bin/blender          # sonst automatisch gesucht
# JUDE_VISION_MODEL=qwen2.5vl:7b        # lokales Modell zum Bilderverstehen
# JUDE_VISION_CLOUD_MODEL=gpt-5.6-terra # Ausweichstufe in der Cloud

# --- Home Assistant (ohne URL und Token bleiben Licht und Grow inaktiv) ---
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HA_LIGHT_WOHNZIMMER=light.wohnzimmer
HA_LIGHT_SCHLAFZIMMER=light.schlafzimmer
HA_LIGHT_FLUR=light.flur
# JSON-Allowlist: Schlüssel sind die in GUI/Agent sichtbaren Aktionsnamen.
# HA_ALEXA_ACTIONS_JSON={"guten_morgen":{"domain":"script","service":"turn_on","entity_id":"script.guten_morgen"}}
# HA_GROW_ACTIONS_JSON={"licht_an":{"domain":"switch","service":"turn_on","entity_id":"switch.growlicht"}}
HA_ALEXA_ACTIONS_JSON={}
HA_GROW_ACTIONS_JSON={}
# Sensoren fürs Growcontroller-Panel im Cockpit
# HA_GROW_SENSORS_JSON={"temperatur":"sensor.grow_temp","feuchte":"sensor.grow_hum"}

# --- Standort für Regenradar und Wetter (Standard: 35039 Marburg) ---
# JUDE_RADAR_ZIP=35039
# JUDE_RADAR_CITY=Marburg
# JUDE_RADAR_ADDRESS=
# JUDE_RADAR_LAT=50.8075
# JUDE_RADAR_LON=8.7708
# JUDE_RADAR_ZOOM=10       # höher = näher; 9 ≈ 50 km, 10 ≈ 25 km

# --- Märkte / ICT ---
ICT_SCHEDULER_ENABLED=true
ICT_TIMEZONE=America/New_York
ICT_LOCAL_TIMEZONE=Europe/Berlin
# ICT_KILL_ZONES=[{"name":"London Open","start":"02:00","end":"05:00"}]
MT5_MCP_COMMAND=

# --- Sicherheit ---
# JUDE_PRIVILEGED=true    # false = auch bestätigte Systembefehle werden blockiert
# JUDE_BLENDER_RAW=false  # true erlaubt vom Modell geschriebene Roh-Skripte (Risiko)
# JUDE_SSH_HOSTS=pi,vps   # nur diese Hosts darf Jude erreichen (nach Bestätigung)
# JUDE_SANDBOX_IMAGE=     # Container-Abbild zum Prüfen erzeugter Werkzeuge
