# Modelle
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
JUDE_PAID_MODELS_ENABLED=true
JUDE_CLOUD_BUDGET_USD=5.00
JUDE_CLOUD_REQUEST_LIMIT_USD=1.00
# Kein Anthropic Fast-/Priority-Tarif: Standard wird explizit erzwungen.
ANTHROPIC_SERVICE_TIER=standard_only
OPENAI_SERVICE_TIER=default
NEWS_API_KEY=
FACT_CHECK_MAX_CLAIMS=5

# GUI: Pflicht bei Remote-Zugriff
JARVIS_GUI_USER=
JARVIS_GUI_PASSWORD=

# Home Assistant
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HA_LIGHT_WOHNZIMMER=light.wohnzimmer
HA_LIGHT_SCHLAFZIMMER=light.schlafzimmer
HA_LIGHT_FLUR=light.flur
# JSON-Allowlist: Schlüssel sind die in GUI/Agent sichtbaren Aktionsnamen.
# HA_ALEXA_ACTIONS_JSON={"guten_morgen":{"domain":"script","service":"turn_on","entity_id":"script.guten_morgen"}}
# HA_GROW_ACTIONS_JSON={"licht_an":{"domain":"switch","service":"turn_on","entity_id":"switch.growlicht"}}
HA_ALEXA_ACTIONS_JSON={}
HA_GROW_ACTIONS_JSON={}

# ICT/SMC: Zeiten sind standardmäßig in America/New_York vorkonfiguriert
ICT_SCHEDULER_ENABLED=true
ICT_TIMEZONE=America/New_York
ICT_LOCAL_TIMEZONE=Europe/Berlin
# Optionaler Override als JSON, sonst gelten die geprüften Standardfenster
# ICT_KILL_ZONES=[{"name":"London Open","start":"02:00","end":"05:00"}]
MT5_MCP_COMMAND=/home/d4sd1ng/trading/venv/bin/python /home/d4sd1ng/trading/mt5_mcp.py

# Lokale Sprache
WHISPER_MODEL=/media/d4sd1ng/AI-Data/Jarvis/models/whisper-small
WHISPER_LANGUAGE=de
WAKE_WORD_THRESHOLD=0.42
PIPER_MODEL=/media/d4sd1ng/AI-Data/Jarvis/models/piper/de_DE-thorsten-medium.onnx

# Web-GUI / Dienst
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Mailkonten: USERNAME ist optional, PASSWORD/App-Passwort erforderlich
MAIL_GMX_USERNAME=d4sd1ng@gmx.de
MAIL_GMX_PASSWORD=
MAIL_YAHOO_USERNAME=t.schneiderx@yahoo.de
MAIL_YAHOO_PASSWORD=
MAIL_GMAIL_USERNAME=d4sd1ng@gmail.com
MAIL_GMAIL_PASSWORD=
MAIL_PROTON_NUROVELLE_USERNAME=nurovelle@proton.me
MAIL_PROTON_NUROVELLE_PASSWORD=
MAIL_PROTON_NUROVELLE_IMAP_PORT=1143
MAIL_PROTON_NUROVELLE_SMTP_PORT=1025
MAIL_PROTON_NUROVELLE_VERIFY_TLS=false
MAIL_PROTON_MONGOJUDE_USERNAME=mongojude@proton.me
MAIL_PROTON_MONGOJUDE_PASSWORD=
MAIL_PROTON_MONGOJUDE_IMAP_PORT=1143
MAIL_PROTON_MONGOJUDE_SMTP_PORT=1025
MAIL_PROTON_MONGOJUDE_VERIFY_TLS=false
# --- Sprachausgabe / Stimme ---
# JUDE_USER_NAME=Tino          # wie Jude den Nutzer anspricht
# JUDE_TTS_PITCH=1.08          # Tonhöhe: >1 heller/weniger tief, 1.0 = neutral
# JUDE_TTS_SPEED=1.0           # Sprechtempo
# PIPER_MODEL=/pfad/zur/stimme.onnx   # überschreibt das Standardmodell
# WHISPER_MODEL=/pfad/zu/whisper-base # überschreibt das Spracherkennungsmodell
# JUDE_BRIEFING=true          # Kurzbriefing (Märkte + News) beim Aufwachen vorlesen
# JUDE_BRIEFING_ICT_LIVE=false # true = frische ICT/SMC-Analyse pro Aufwachen (langsam, MT5 nötig); sonst letzte Trading Card

# --- Gedächtnis & Profil ---
# JUDE_PROFILE=Ich handle Gold und BTC nach ICT; Ich bevorzuge kurze Antworten   # per Semikolon, wird als bestätigte Erinnerung angelegt
# JUDE_MEMORY_AUTOAPPROVE=0.8  # Konfidenzschwelle: starke Identitätsfakten ab hier automatisch bestätigt

# --- Bilder ---
# JUDE_IMAGE_MODEL=gpt-image-1   # OpenAI-Bildmodell für Erzeugen/Bearbeiten
# BLENDER_BIN=/usr/bin/blender   # Pfad zu Blender (sonst automatisch gesucht)
# JUDE_VISION_MODEL=qwen2.5vl:7b       # lokales Vision-Modell (Bilder verstehen)
# JUDE_VISION_CLOUD_MODEL=gpt-5.6-terra # Cloud-Fallback, falls kein lokales Vision-Modell

# --- Sicherheit ---
# JUDE_ALLOWED_HOSTS=meinpc.local   # zusätzliche erlaubte Host-Header (CSRF/DNS-Rebinding-Schutz)
# JUDE_BLENDER_RAW=false            # true erlaubt vom Modell geschriebene Roh-Blender-Skripte (Risiko)

# --- Standort Regenradar/Wetter (Standard: 35039 Marburg) ---
# JUDE_RADAR_ZIP=35039
# JUDE_RADAR_CITY=Marburg
# JUDE_RADAR_LAT=50.8075
# JUDE_RADAR_LON=8.7708
# JUDE_RADAR_ZOOM=9        # höher = näher; 9 ≈ 50 km, 10 ≈ 25 km

# --- Privilegierter Freibrief (nach ausdrücklicher Bestätigung) ---
# JUDE_PRIVILEGED=true   # false = auch bestätigte Systembefehle werden blockiert

# --- SSH (freigegebene Hosts; sonst ~/.ssh/config-Aliase) ---
# JUDE_SSH_HOSTS=pi,vps    # nur diese Hosts darf Jude per ssh/scp erreichen (nach Bestätigung, schlüsselbasiert)
